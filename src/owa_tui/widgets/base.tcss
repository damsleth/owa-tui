/* base.tcss — shared status bar and overlay styles for owa-tui.
 *
 * Colours come from the active Textual theme ($primary, $surface, $border,
 * $text, $text-muted, …) so the app follows whatever theme the user picks
 * (light or dark) via the command palette.  Do NOT redefine those variables
 * here with literal hex — that shadows the theme and pins one palette. */

/* ── App shell ────────────────────────────────────────────────────────── */
Screen {
    background: $surface;
    color: $text;
    /* Under ansi themes $surface is fully transparent, so Textual keeps
     * compositing the screens underneath (home bleeds through doctor).
     * $background is the opaque terminal default there. */
    &:ansi {
        background: $background;
    }
}

/* ── Content breathing room ───────────────────────────────────────────────
 * AppHeader/Footer/StatusBar dock flush to the screen edges; only the body
 * content is indented. Type selectors match subclasses, so this one rule
 * covers _OwaList / MessageList / PeopleList (ListView) and grid DataTables.
 * Tune the values to taste. */
ListView,
DataTable {
    margin: 1 0 0 1;
}

#owa-grid-breadcrumb,
#breadcrumb {
    padding-left: 1;
}

/* ── Status bar ───────────────────────────────────────────────────────── */
/* Docked over AppHeader row 3 (the identity tail); hidden while empty so
 * the tail shows through. Opaque background so row 3 doesn't bleed. */
StatusBar {
    dock: top;
    margin-top: 2;
    height: 1;
    width: 1fr;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    &:ansi {
        background: $background;
    }
}

/* notify() toasts: top-right, under the header, next to the status row. */
ToastRack {
    dock: top;
    align: right top;
    margin: 3 0 0 0;
}

/* ── Detail pane ──────────────────────────────────────────────────────── */
DetailPane {
    overflow-y: scroll;
    padding: 0 1;
    border-left: solid $border;
}

/* ── Overlay ──────────────────────────────────────────────────────────── */
/* The Screen rule above also matches ModalScreen and would paint $surface
 * (== 'transparent' in ansi themes). Opaque $background follows the theme
 * and is the terminal's own colour under ansi-dark, so ctrl+t works here. */
SettingsOverlay {
    background: $background;
}

/* ── Home screen ──────────────────────────────────────────────────────── */
